{
  "manifest_version": 3,
  "name": "SAFlow Extension",
  "version": "2.1.2",
  "description": "Download YouTube videos as MP3 or MP4 from a button in the player. Developed by SA Brothers.",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "alarms"],
  "host_permissions": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "content_scripts": [
    { "matches": ["https://www.youtube.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SAFlow Extension",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "browser_specific_settings": { "gecko": { "id": "ytmp3@local", "strict_min_version": "121.0" } }
}
